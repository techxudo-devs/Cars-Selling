DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Preserve authority from superseded blog URLs.
  RewriteRule ^blogs/japanese-imported-cars-for-sale-australia/?$ /blogs/how-to-buy-a-japanese-imported-car-australia/ [R=301,L,NE]
  RewriteRule ^blogs/import-cars-from-japan-guide/?$ /blogs/how-to-import-a-car-from-japan-to-australia/ [R=301,L,NE]
  RewriteRule ^sold-cars/2018-toyota-prius-c-hyrbid-27/?$ /sold-cars/2018-toyota-prius-c-hybrid-27/ [R=301,L,NE]

  # Permanently redirect legacy query-string vehicle URLs to canonical car pages.
  # Keep these rules before the generic static-export routing rules below.
  RewriteCond %{QUERY_STRING} (^|&)id=0(&|$)
  RewriteRule ^car-details/?$ /available-cars/2007-mitsubishi-lancer-evolution-x-gsr-ryushon-0/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=1(&|$)
  RewriteRule ^car-details/?$ /available-cars/2007-lexus-ls600h-v8-5000cc-1/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=2(&|$)
  RewriteRule ^car-details/?$ /available-cars/2007-lexus-ls460-v8-4600cc-2/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=3(&|$)
  RewriteRule ^car-details/?$ /available-cars/2013-toyota-prius-hybrid-3/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=4(&|$)
  RewriteRule ^car-details/?$ /sold-cars/toyota-prius-2011-4/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=5(&|$)
  RewriteRule ^car-details/?$ /sold-cars/toyota-crown-sedan-2010-5/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=6(&|$)
  RewriteRule ^car-details/?$ /sold-cars/honda-vezel-2014-6/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=7(&|$)
  RewriteRule ^car-details/?$ /sold-cars/lexus-ls460-v8-2012-7/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=8(&|$)
  RewriteRule ^car-details/?$ /sold-cars/lexus-ls460-2006-v8-luxury-8/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=9(&|$)
  RewriteRule ^car-details/?$ /sold-cars/mitsubishi-lancer-evolution-2007-9/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=10(&|$)
  RewriteRule ^car-details/?$ /sold-cars/lexus-ls460-v8-2007-10/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=11(&|$)
  RewriteRule ^car-details/?$ /sold-cars/toyota-c-hr-hybrid-g-mode-nero-11/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=12(&|$)
  RewriteRule ^car-details/?$ /sold-cars/mercedes-benz-s400h-hybrid-12/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=13(&|$)
  RewriteRule ^car-details/?$ /sold-cars/honda-grace-hybrid-ex-2015-13/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=14(&|$)
  RewriteRule ^car-details/?$ /sold-cars/toyota-yaris-hybrid-g-awd-2020-14/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=15(&|$)
  RewriteRule ^car-details/?$ /sold-cars/lexus-ls460-v8-rwd-2013-15/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=16(&|$)
  RewriteRule ^car-details/?$ /sold-cars/honda-fit-hybrid-ehev-16/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=17(&|$)
  RewriteRule ^car-details/?$ /sold-cars/suzuki-swift-hybrid-hatchback-17/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=18(&|$)
  RewriteRule ^car-details/?$ /sold-cars/honda-fit-hybrid-2018-18/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=19(&|$)
  RewriteRule ^car-details/?$ /sold-cars/toyota-crown-rs-advance-2019-19/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=20(&|$)
  RewriteRule ^car-details/?$ /sold-cars/lexus-ls460-v8-rwd-2007-20/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=21(&|$)
  RewriteRule ^car-details/?$ /sold-cars/honda-vezel-hybrid-2014-21/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=22(&|$)
  RewriteRule ^car-details/?$ /sold-cars/toyota-c-hr-hybrid-2018-22/ [R=301,L,NE,QSD]
