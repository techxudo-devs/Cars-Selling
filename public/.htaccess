  RewriteRule ^car-details/?$ /available-cars/2007-lexus-ls600hl-v8-5000cc-23/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=24(&|$)
  RewriteRule ^car-details/?$ /available-cars/2013-bmw-m5-f10-4-4l-twin-turbo-v8-24/ [R=301,L,NE,QSD]
