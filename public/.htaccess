  RewriteRule ^car-details/?$ /sold-cars/2024-yaris-hybrid-4wd-25/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=26(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2009-crown-3-5l-v6-hybrid-26/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=27(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2018-toyota-prius-c-hybrid-27/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=28(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2014-toyota-prius-c-aqua-28/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=29(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2020-yaris-hybrid-x-4wd-29/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=30(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2020-yaris-hybrid-z-4wd-30/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=31(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2014-lexus-ct200h-f-sport-31/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=32(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2020-lexus-ct200h-hybrid-32/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=33(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2015-audi-a4-quattro-sedan-33/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=34(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2020-toyota-vitz-yaris-hybrid-34/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=35(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2014-honda-vezel-hrv-hybrid-35/ [R=301,L,NE,QSD]
  RewriteCond %{QUERY_STRING} (^|&)id=36(&|$)
  RewriteRule ^car-details/?$ /sold-cars/2019-toyota-vitz-yaris-hybrid-36/ [R=301,L,NE,QSD]

  # Next static export creates route folders such as /dashboard/login/index.html.
  # Hostinger sometimes does not resolve the same route without the trailing slash.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.+)$ %{REQUEST_URI}/ [R=301,L]

  # Serve exported route folders when a clean URL is requested.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Let static files and Next assets pass through normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  ErrorDocument 404 /404.html
</IfModule>
